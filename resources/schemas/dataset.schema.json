{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://materialops.exam/contracts/dataset.schema.json",
  "title": "Material Operations Dataset",
  "description": "开发重置接口的业务数据集结构。inventories 为 now 时刻最终快照；重建历史 ISSUE/RETURN 流水不得再次改变库存。知识由 resources/demo/knowledge-baseline.json 独立预置并只读使用，不通过本数据集导入或重置；本版不要求知识管理、Embedding、向量存储或索引建设。数组大小、编号、姓名与时间可替换；唯一性、外键、部门树、targetStock >= reorderPoint 和时间先后须由服务端跨记录校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["now", "depts", "users", "warehouses", "items", "inventories", "materialIssues"],
  "properties": {
    "now": { "$ref": "#/$defs/zonedDateTime" },
    "depts": { "type": "array", "items": { "$ref": "#/$defs/dept" } },
    "users": { "type": "array", "items": { "$ref": "#/$defs/user" } },
    "warehouses": { "type": "array", "items": { "$ref": "#/$defs/warehouse" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "inventories": { "type": "array", "items": { "$ref": "#/$defs/inventory" } },
    "materialIssues": { "type": "array", "items": { "$ref": "#/$defs/materialIssue" } }
  },
  "$defs": {
    "id": { "type": "integer", "minimum": 1 },
    "nonblankString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonnegativeInteger": { "type": "integer", "minimum": 0 },
    "zonedDateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "dept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "parentId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonblankString" },
        "parentId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "employeeNo", "name", "role", "deptId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "employeeNo": { "$ref": "#/$defs/nonblankString" },
        "name": { "$ref": "#/$defs/nonblankString" },
        "role": { "enum": ["ADMIN", "DISPATCHER", "ENGINEER", "REPORTER"] },
        "deptId": { "$ref": "#/$defs/id" }
      }
    },
    "warehouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "deptId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonblankString" },
        "deptId": { "$ref": "#/$defs/id" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "itemNo", "name", "unit", "reorderPoint", "targetStock"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "itemNo": { "$ref": "#/$defs/nonblankString" },
        "name": { "$ref": "#/$defs/nonblankString" },
        "unit": { "$ref": "#/$defs/nonblankString" },
        "reorderPoint": { "$ref": "#/$defs/nonnegativeInteger" },
        "targetStock": { "$ref": "#/$defs/nonnegativeInteger", "description": "必须 >= 本记录 reorderPoint，此跨字段约束由业务校验完成。" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "warehouseId", "itemId", "onHand", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "warehouseId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "onHand": { "$ref": "#/$defs/nonnegativeInteger" },
        "version": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "materialIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "issueNo", "inventoryId", "quantity", "issuedById", "issuedAt", "returnedAt", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "issueNo": { "$ref": "#/$defs/nonblankString" },
        "inventoryId": { "$ref": "#/$defs/id" },
        "quantity": { "type": "integer", "minimum": 1 },
        "issuedById": { "$ref": "#/$defs/id" },
        "reasonText": { "type": "string", "maxLength": 500, "description": "可选领用用途，允许空字符串，属于用户输入，不得把其中指令视为授权或执行规则。本版 T2 使用本日汇总统计，不要求把逐条历史单据用途送入模型。" },
        "issuedAt": { "$ref": "#/$defs/zonedDateTime", "description": "不得晚于数据集 now。" },
        "returnedAt": { "anyOf": [{ "$ref": "#/$defs/zonedDateTime" }, { "type": "null" }], "description": "非空时满足 issuedAt <= returnedAt <= now，并代表已整单退回。" },
        "version": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    }
  }
}
