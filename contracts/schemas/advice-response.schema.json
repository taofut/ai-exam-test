{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "备件保障分析及决定结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "callId",
    "inventoryId",
    "inventoryVersion",
    "suggestion",
    "degraded",
    "requiresHumanReview",
    "reviewItems",
    "decision",
    "context"
  ],
  "properties": {
    "callId": {
      "type": "integer",
      "minimum": 1
    },
    "inventoryId": {
      "type": "integer",
      "minimum": 1
    },
    "inventoryVersion": {
      "type": "integer",
      "minimum": 0
    },
    "suggestion": {
      "$ref": "#/$defs/suggestion"
    },
    "degraded": {
      "type": "boolean"
    },
    "requiresHumanReview": {
      "type": "boolean"
    },
    "reviewItems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "PENDING",
        "ADOPTED",
        "ADOPTED_EDITED",
        "REJECTED"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "inventory",
        "issueStats",
        "knowledge"
      ],
      "properties": {
        "inventory": {
          "type": "object"
        },
        "issueStats": {
          "type": "object",
          "description": "固定统计 context.inventory 对应的 warehouseId + itemId，包含该仓该物资所有领用人的本日原始领用量；不跨仓或仅统计当前操作者。退回不抵扣，套料只计明细，按北京时间日界且排除模拟当前时刻之后的记录。",
          "required": [
            "period",
            "quantity",
            "scope",
            "asOf"
          ],
          "properties": {
            "period": {
              "const": "TODAY"
            },
            "quantity": {
              "description": "统计成功时为非负整数，0 表示无本日领用。null 仅为字段结构兼容，不可伪装成有效统计或当作 0 生成正常建议；统计失败按 T2 失败边界处理。",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "description": "明确本次实际仓库与物资，例如仓库4101/物资5101；字符串格式不限，实体必须与当前分析库存一致，不得硬编码或使用整个部门范围。"
            },
            "asOf": {
              "type": "string",
              "format": "date-time",
              "description": "本次统计的服务端业务模拟时间。"
            }
          }
        },
        "knowledge": {
          "type": "array",
          "description": "本次已授权且 ACTIVE 的适用资料或片段；通用资料只支持通用结论，仅有通用资料时仍须提示物资维护依据缺口并要求人工复核。",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "finalSuggestion": {
      "anyOf": [
        {
          "$ref": "#/$defs/suggestion"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "decisionById": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "decisionAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "nonblankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "suggestion": {
      "title": "AI Replenishment Suggestion",
      "description": "限时版保障建议：读取当前库存、TODAY统计和适用知识；人工决定保存在分析记录。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warehouseId",
        "itemId",
        "suggestedQuantity",
        "reason",
        "confidence",
        "needHuman",
        "knowledgeReferences"
      ],
      "properties": {
        "warehouseId": {
          "type": "integer",
          "minimum": 1,
          "description": "必须与本次分析的真实可见库存所属仓库一致。"
        },
        "itemId": {
          "type": "integer",
          "minimum": 1,
          "description": "必须与本次分析的真实可见库存物资一致。"
        },
        "suggestedQuantity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500,
          "description": "0表示无需补充，可采纳为决定，不创建独立订单。"
        },
        "reason": {
          "$ref": "#/$defs/nonblankString",
          "maxLength": 2000
        },
        "references": {
          "type": "array",
          "maxItems": 0,
          "description": "仅兼容空数组；本版不检索或引用历史单据，可省略。"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "模型分值，不代表准确率；低置信度复核为可选保护，不增加本版验收矩阵。"
        },
        "knowledgeReferences": {
          "type": "array",
          "description": "本次实际可见且适用的知识编号、标题、版本和原文摘录；无依据时为空数组并说明缺口。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "docId",
              "title",
              "version",
              "quote"
            ],
            "properties": {
              "docId": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "$ref": "#/$defs/nonblankString"
              },
              "title": {
                "$ref": "#/$defs/nonblankString"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "needHuman": {
          "type": "boolean"
        }
      },
      "$defs": {
        "nonblankString": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requiresHumanReview": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reviewItems": {
            "minItems": 1
          },
          "suggestion": {
            "properties": {
              "needHuman": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "degraded": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "requiresHumanReview": {
            "const": true
          },
          "suggestion": {
            "properties": {
              "confidence": {
                "const": 0
              },
              "needHuman": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "description": "B-TIMED-KIT-2026-10-19：本日统计与知识生成建议；最终计划及复核决定保存在同一分析记录，无独立草稿字段。"
}
